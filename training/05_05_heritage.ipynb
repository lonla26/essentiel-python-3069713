   "source": [
    "class Salarie(object):\n",
    "  def __init__(self, nom, nos):\n",
    "    self.nom = nom\n",
    "    self.nos = nos\n",
    "\n",
    "  def afficher(self):\n",
    "    print(\"Nom:\", self.nom)\n",
    "    print(\"Num salarié:\", self.nos)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "336253e1",
   "metadata": {},
   "outputs": [],
   "source": [
    "s = Salarie(\"Alisson\", \"AP123456\")"
   ]
  },
  {
   "cell_type": "code",
